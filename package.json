{
  "name": "pawmap-thailand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "compression": "1.8.2",
    "lighthouse": "13.4.1",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify:no-github": "node scripts/verify-no-github.mjs",
    "verify:sources": "node scripts/verify-source-allowlist.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:interactions": "node scripts/verify-interactions.mjs",
    "verify:release": "node scripts/verify-release-safety.mjs",
    "verify:data": "node scripts/verify-boundaries.mjs",
    "verify": "npm run verify:release && npm run verify:no-github && npm run verify:sources && npm run verify:data && npm run verify:migrations && npm run verify:interactions && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "data:import": "node scripts/import-boundaries.mjs",
    "places:import": "tsx scripts/import-pet-places.ts",
    "places:export-public": "tsx scripts/export-public-places.ts",
    "places:import-public": "tsx scripts/import-public-places.ts",
    "places:verify-public-install": "tsx scripts/verify-public-install.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test-users": "tsx prisma/seed-test-users.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.2.1",
    "@prisma/client": "6.12.0",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "file-type": "21.3.4",
    "lucide-react": "0.544.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prisma": "6.12.0",
